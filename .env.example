# Server-side secrets / configuration. Copy this file to .env and fill the values.
# Never put GEMINI_API_KEY in app.js or in a browser-exposed file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase public web API key is used only by the server to verify ID tokens through
# Firebase Identity Toolkit. It is not a password, but restrict its APIs/domains in GCP.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=tribal-antler-3mn89
FIRESTORE_DATABASE_ID=ai-studio-01751af4-8ee9-4b9b-8158-67aebfccb9a0
PORT=3000
APP_ORIGIN=
